---
import Base from '../layouts/Base.astro'
import { useTranslations } from '../i18n/index'
import { getPageBySlug } from '../lib/pages'
import { sanitizeCmsHtml } from '../lib/sanitize'

const t = useTranslations('de')
const { slug } = Astro.params
const page = slug ? await getPageBySlug(slug) : null

if (!page) {
  Astro.response.status = 404
}
---

{page ? (
  <Base title={page.title} lang="de">
    <section class="max-w-3xl mx-auto px-4 py-12">
      <h1 class="text-2xl sm:text-3xl font-bold text-navy mb-6">{page.title}</h1>
      <div class="cms-content" set:html={sanitizeCmsHtml(page.content)} />
    </section>
  </Base>
) : (
  <Base title={t('notFound.heading')} lang="de">
    <section class="max-w-3xl mx-auto px-4 py-12">
      <h1 class="text-2xl sm:text-3xl font-bold text-navy mb-6">{t('notFound.heading')}</h1>
      <p class="text-gray-600">{t('notFound.body')}</p>
    </section>
  </Base>
)}
