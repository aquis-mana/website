---
import Base from '../layouts/Base.astro'
import EventCalendar from '../components/EventCalendar.astro'
import RsvpOverlay from '../components/RsvpOverlay.astro'
import { useTranslations } from '../i18n/index'
import { getAdapter } from '../adapters/calendar'
import type { CalendarEvent } from '../adapters/calendar'
import { createLogger } from '../lib/logger'

const log = createLogger('index')

const siteKey = process.env.PUBLIC_TURNSTILE_SITE_KEY ?? ''

const t = useTranslations('de')
let events: CalendarEvent[] = []
try {
  const adapter = await getAdapter()
  events = await adapter.getUpcomingEvents()
} catch (err) {
  log.error('failed to load events', err)
}
---

<Base title="Startseite" lang="de">
  <div class="max-w-6xl mx-auto px-4 py-10">
    <EventCalendar events={events} lang="de" />

    <section class="mt-20 max-w-2xl">
      <h2 class="text-2xl font-bold text-navy mb-4">{t('home.intro.heading')}</h2>
      <p class="text-gray-700 leading-relaxed">{t('home.intro.body')}</p>
    </section>
  </div>

  <!-- Invisible Turnstile: the sitekey is configured in Invisible mode, so no
       widget or badge is ever shown. A token is produced in the background and
       refreshed when it expires or when the RSVP dialog opens. -->
  <div id="page-turnstile"></div>
  <script is:inline define:vars={{ siteKey }} nonce={Astro.locals.cspNonce}>
    window._turnstileSiteKey = siteKey
    window.onTurnstileLoad = function () {
      var widgetId = turnstile.render('#page-turnstile', {
        sitekey: window._turnstileSiteKey,
        // Re-run the invisible challenge when the token expires (~5 min) so a
        // valid token is always ready by the time someone submits an RSVP.
        'expired-callback': function () { turnstile.reset(widgetId) },
      })
      // Let RsvpOverlay request a fresh token when the dialog opens.
      window.refreshTurnstile = function () { turnstile.reset(widgetId) }
    }
  </script>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onTurnstileLoad&render=explicit" async defer></script>

  <RsvpOverlay lang="de" />
</Base>
