---
import { useTranslations } from '../i18n/index'
import type { RsvpStats } from '../lib/rsvp'

interface Props {
  stats: RsvpStats
  lang?: 'de' | 'en'
}

const { stats, lang = 'de' } = Astro.props
const t = useTranslations(lang)
---

<!-- shrink-0 keeps the badge on one line when a long event title shares the row -->
<div class="shrink-0 text-right">
  <div class="flex items-center justify-end gap-2 text-sm whitespace-nowrap">
    {stats.capacity !== null ? (
      <span class:list={[
        'font-mono px-2 py-0.5 rounded text-xs font-semibold whitespace-nowrap',
        stats.isOverFull ? 'bg-red-100 text-red-700' :
        stats.isNearFull ? 'bg-yellow-100 text-yellow-700' :
        'bg-green-100 text-green-700'
      ]}>
        {stats.total} / {stats.capacity}
      </span>
    ) : (
      <span class="font-mono text-xs text-gray-500 whitespace-nowrap">{stats.total} {t('events.attending')}</span>
    )}

    {stats.isOverFull && (
      <span class="text-xs text-red-600 font-semibold whitespace-nowrap">{t('events.full')}</span>
    )}
    {stats.isNearFull && !stats.isOverFull && (
      <span class="text-xs text-yellow-600 font-semibold whitespace-nowrap">{t('events.nearFull')}</span>
    )}
  </div>

  {stats.isOverFull && (
    <details class="mt-1 text-xs text-gray-500 text-left">
      <summary class="cursor-pointer hover:text-navy">{t('events.priority.heading')}</summary>
      <ol class="mt-1 ml-4 list-decimal space-y-0.5">
        <li>{t('events.priority.membersYes')}</li>
        <li>{t('events.priority.visitorsYes')}</li>
        <li>{t('events.priority.membersMaybe')}</li>
        <li>{t('events.priority.visitorsMaybe')}</li>
      </ol>
    </details>
  )}
</div>
