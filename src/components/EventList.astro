---
import { useTranslations } from '../i18n/index'
import { groupEvents } from '../lib/event-groups'
import { formatEventListParts, type EventTimeVariant } from '../lib/datetime'
import { gameTag, displayTitle } from '../lib/event-display'
import type { CalendarEvent } from '../adapters/calendar'

interface Props {
  events: CalendarEvent[]
  lang?: 'de' | 'en'
}

const { events, lang = 'de' } = Astro.props
const t = useTranslations(lang)

// The pod runs in UTC, so SSR must group and format with an explicit zone. The
// club is in Aachen, so Europe/Berlin is the right one; the client script below
// re-renders each row's time in the visitor's own zone.
const TZ = 'Europe/Berlin'
const groups = groupEvents(events, new Date(), TZ)

const sections: {
  key: string
  label: string
  items: CalendarEvent[]
  variant: EventTimeVariant
  today: boolean
}[] = [
  { key: 'today', label: t('events.today'), items: groups.today, variant: 'time', today: true },
  { key: 'upcoming', label: t('events.upcoming'), items: groups.upcoming, variant: 'weekday', today: false },
  { key: 'other', label: t('events.other'), items: groups.other, variant: 'full', today: false },
]
const visible = sections.filter((s) => s.items.length > 0)
---

<section class="w-full">
  <h2 class="text-2xl font-bold text-navy mb-8 tracking-tight">{t('events.heading')}</h2>

  {visible.length === 0 ? (
    <p class="text-gray-500 text-center py-12">{t('events.empty')}</p>
  ) : (
    visible.map((section) => (
      <div class="mt-9 first:mt-0">
        <h3 class="flex items-center gap-2.5 text-xs font-bold uppercase tracking-[0.09em] text-gray-500 pb-2.5 mb-1 border-b border-gray-200">
          {section.today && <span class="inline-block h-1.5 w-1.5 rounded-full bg-blue-accent"></span>}
          {section.label}
        </h3>
        <ul>
          {section.items.map((event) => {
            const tag = gameTag(event.title)
            const iso = event.date.toISOString()
            const { lead, time } = formatEventListParts(event.date, lang, section.variant, TZ)
            return (
              <li class="group grid grid-cols-[4.5rem_minmax(0,1fr)_max-content] items-baseline gap-x-4 border-b border-gray-100 py-3.5 last:border-b-0">
                <span
                  class="text-[11px] font-bold uppercase tracking-wide whitespace-nowrap"
                  style={tag ? `color:${tag.color}` : undefined}
                >{tag?.label ?? ''}</span>

                <span class="min-w-0">
                  <span class="text-[15px] font-semibold text-navy transition-colors group-hover:text-blue-accent">
                    {displayTitle(event.title)}
                  </span>
                  {event.seriesId !== null && (
                    <svg
                      class="ml-1.5 inline-block h-3 w-3 -translate-y-px align-middle text-gray-400"
                      viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                      stroke-linecap="round" stroke-linejoin="round" role="img" aria-label={t('events.recurring')}
                    >
                      <title>{t('events.recurring')}</title>
                      <path d="M17 2l4 4-4 4" />
                      <path d="M3 11V9a4 4 0 0 1 4-4h14" />
                      <path d="M7 22l-4-4 4-4" />
                      <path d="M21 13v2a4 4 0 0 1-4 4H3" />
                    </svg>
                  )}
                </span>

                <span
                  class="flex items-baseline justify-end gap-3.5 tabular-nums"
                  data-when data-variant={section.variant} data-lang={lang} data-iso={iso}
                >
                  <span class="whitespace-nowrap text-[13px] text-gray-400" data-lead>{lead}</span>
                  <span
                    class:list={[
                      'whitespace-nowrap text-sm',
                      section.today ? 'font-bold text-navy' : 'text-gray-500',
                    ]}
                    data-time
                  >{time}</span>
                </span>
              </li>
            )
          })}
        </ul>
      </div>
    ))
  )}
</section>

<script>
  import { formatEventListParts, type EventTimeVariant } from '../lib/datetime'

  // Re-render each row's lead + time in the visitor's own timezone. SSR rendered
  // them in Europe/Berlin; passing no timeZone here uses the browser's zone.
  for (const el of document.querySelectorAll<HTMLElement>('[data-when]')) {
    const iso = el.dataset.iso
    const variant = el.dataset.variant as EventTimeVariant | undefined
    if (!iso || !variant) continue
    const lang = el.dataset.lang === 'en' ? 'en' : 'de'
    const { lead, time } = formatEventListParts(iso, lang, variant)
    const leadEl = el.querySelector('[data-lead]')
    const timeEl = el.querySelector('[data-time]')
    if (leadEl) leadEl.textContent = lead
    if (timeEl) timeEl.textContent = time
  }
</script>
