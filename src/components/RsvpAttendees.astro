---
import { useTranslations } from '../i18n/index'
import type { RsvpAttendee } from '../lib/rsvp'

interface Props {
  attendees: RsvpAttendee[]
  lang?: 'de' | 'en'
}

const { attendees, lang = 'de' } = Astro.props
const t = useTranslations(lang)
---

<div class="mb-4 text-sm">
  {attendees.length === 0 ? (
    <p class="text-gray-400 text-xs">{t('events.attendees.empty')}</p>
  ) : (
    <details class="text-gray-600">
      <summary class="cursor-pointer text-xs font-semibold text-gray-500 hover:text-navy">
        {t('events.attendees.heading')} ({attendees.length})
      </summary>
      <ul class="mt-2 flex flex-wrap gap-1.5">
        {attendees.map((attendee) => (
          <li
            class:list={[
              'px-2 py-0.5 rounded text-xs',
              attendee.status === 'yes'
                ? 'bg-blue-50 text-navy'
                : 'bg-gray-100 text-gray-500'
            ]}
            title={attendee.status === 'yes' ? t('rsvp.yes') : t('rsvp.maybe')}
          >
            {attendee.name}{attendee.status === 'maybe' && <span class="ml-1 opacity-70">?</span>}
          </li>
        ))}
      </ul>
    </details>
  )}
</div>
